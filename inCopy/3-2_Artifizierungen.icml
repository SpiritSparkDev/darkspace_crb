		<Properties>
			<BorderColor type="enumeration">Black</BorderColor>
			<Destination type="object">n</Destination>
		</Properties>
	</Hyperlink>
	<Hyperlink Self="ue03a2" Name="Querverweis 8" Source="ue03a1" Visible="false" Highlight="None" Width="Thin" BorderStyle="Solid" Hidden="false" EpubAriaRole="" HypherlinkAltText="" DestinationUniqueKey="25421">
		<Properties>
			<BorderColor type="enumeration">Black</BorderColor>
			<Destination type="object">ParagraphDestination/Anker 5</Destination>
		</Properties>
