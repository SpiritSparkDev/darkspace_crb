			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>weiter unten.</Content>
				<Br />
				<Content>Schutzlos: Charaktere oder Gegenstände, die keine Panzerung oder ähnliches tragen, gelten, als hätten sie eine Panzerung mit MK 0.</Content>
				<Br />
				<Content>Erfolg: Das Ziel erleidet den Waffenschaden (Größe / 2, aufrunden) auf dem entsprechenden Monitor.</Content>
				<Br />
				<Content>Kritischer Erfolg: Der Schutz des Ziels wird ignoriert und der Schaden des Angriffs um +2 erhöht.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Waffenschaden</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Waffen, egal ob natürlich, mechanisch oder digital, richten Schaden in Höhe ihrer halben Größe (aufrunden) an. Wenn ein Charakter, Maschine oder System Schaden erleidet, werden eine Anzahl Kästchen entsprechend der halben Größe (aufrunden) der Waffe abgestrichen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schwachstellen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Der Charakter kann sich freiwillig dazu entscheiden, seine Angriffsprobe als erschwerte Probe abzulegen. Dann versucht er eine Schwachstelle am Gegner anzugreifen. Angriffe gegen Schwachstellen behandeln Panzerung als wäre sie nur halb so hoch (aufrunden).</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 56" Name="Anker 56" Hidden="false" DestinationUniqueKey="21893" />
				<Content>Durchschlag</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Durchschlag = MK + Größe</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Der Durchschlag einer Waffe kann einen Kampf sehr schnell beenden - für beide Seiten.</Content>
				<Br />
				<Content>Schwacher Durchschlag: Ist die Panzerung des Ziels größer als der Durchschlag, sind selbst die schwächer geschützten Stellen am Ziel so gut gepanzert, dass Angriff sie nicht durchdringen können. Der Angriff prallt wirkungslos ab.</Content>
				<Br />
				<Content>Starker Durchschlag: Ist der Durchschlag des Charakters größer als die Panzerung des Ziels, kann die Panzerung des Ziels dem Angriff kaum etwas entgegen setzen. Der Angriff erhält +3 auf sein Ergebnis.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenüberschrift">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Sonderfälle durch Durchschlag</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabelle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Table Self="u9aa53id96b7" HeaderRowCount="1" FooterRowCount="0" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" BodyRowCount="2" ColumnCount="2" AppliedTableStyle="TableStyle/Standardtabelle" TableDirection="LeftToRightDirection">
					<Row Self="u9aa53id96b7Row0" Name="0" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleRowHeight="19.888555211345043" />
					<Row Self="u9aa53id96b7Row1" Name="1" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="16.549972534179688" />
					<Row Self="u9aa53id96b7Row2" Name="2" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="16.549972534179688" />
					<Column Self="u9aa53id96b7Column0" Name="0" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleColumnWidth="154.6299212599331" />
					<Column Self="u9aa53id96b7Column1" Name="1" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleColumnWidth="80.3149606297402" />
					<Cell Self="u9aa53id96b7i4" Name="0:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenkopf">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Situation</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9aa53id96b7i5" Name="1:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenkopf">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Wirkung</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9aa53id96b7i0" Name="0:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Panzerung &gt; Durchschlag</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9aa53id96b7i1" Name="1:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Wirkungslos</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9aa53id96b7i2" Name="0:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Durchschlag &gt; Panzerung</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9aa53id96b7i3" Name="1:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Treffer +3</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
				</Table>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Abwehr</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Abwehr bezeichnet die Aufmerksamkeit des Charakters im Kampf. Indem er gezielte Pausen setzt, gewinnt der Charakter an Übersicht auf dem Schlachtfeld zu lasten von Handlungen, für die ihm dann die Zeit fehlt.</Content>
				<Br />
				<Content>Bei einer Abwehr versucht der Charakter einen anderen an einer Handlung zu hindern und seine Handlungsphase zu beenden. Sie zielen nicht auf einen Monitor, sondern auf den Charakter oder die Maschine selbst.</Content>
				<Br />
				<Content>Bei einer physischen Abwehr muss der Charakter phyischen Kontakt zu seinem Ziel haben. Für eine Abwehr im Cortex, muss das System des Charakters im selben Netzwerk sein wie das Ziel.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Abwehr erzeugen: Abwehr wird durch das Aufsparen von AE erzeugt. Jede AE, die am Ende einer Handlungsphase nicht verwendet wurde, wird in Abwehr umgewandelt. Der Charakter kann maximal eine Abwehr von 5 ansammeln. </Content>
				<Br />
				<Content>Flüchtig: Abwehr ist ein temporärer Spielwert. Am Ende der Konfrontation verfällt ungenutzte Abwehr.</Content>
				<Br />
				<Content>Kontakt: Der Charakter muss phyischen Kontakt zum Ziel haben, dass er abwehren will. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Einsatz von Abwehr</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Abwehr kann außerhalb der eigenen Handlungsphase ausgegeben werden, um das Ergebnis eines Angreifers um 1 zu senken. Routinen scheitern beim Ausgeben von 1 Abwehr automatisch.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Abwehren im Fernkampf: Niederhalten</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ein Charakter kann ein Ziel niederhalten, indem es auf seine Position schießt. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Der Charaker muss dafür eine Schusslinie zum Ziel haben.</Content>
				<Br />
				<Content>Die Waffe des Charakters muss in der Lage ist, das Ziel zu verwunden (siehe ##Durchschlag).</Content>
				<Br />
				<Content>Das Ziel erleidet -[Größe der Waffe] auf seinen Angriffswurf.</Content>
				<Br />
				<Content>Niedergehaltene Ziele, die erfolgreiche Handlungen durchführen, werden automatisch von der Waffe auf ihren Defensivmonitor getroffen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Einschießen: Ist die erste Handlung des Charakters in seiner nächsten Handlungsphase, auf dasslebe Ziel zu schießen, das er gerade niedergehalten hat, kostet sein erster Angriff 1 AE weniger.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 48" Name="Anker 48" Hidden="false" DestinationUniqueKey="21536" />
				<Content>Abwehren im Cortex</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Cortex-Blockade: Für eine Blockierung via Cortex muss das System des Charakters und das Ziel im selben Netzwerk sein. Bei einer Blockade über den Cortex wird das Ergebnis von Proben zusätzlich um die MK des Systems des Charakters gesenkt.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Abwehren von Bewegungen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ein Charakter oder Maschine kann versuchen einen andere Charakter oder Maschine an einer </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Inline-Probe">
				<Content>Bewegung</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> zu hindern. </Content>
				<Br />
				<Content>Reichweite: Der Charakter muss mit einer gewählten Waffe in Reichweite sein. Er kann Abwehr als AE ausgeben um sich ggf. zu bewegen.</Content>
				<Br />
				<Content>Behindern: Bewegungen zu verhindern folgt den normalen Regeln für Abwehren. In diesem Fall führt das ausgeben von 1 Punkt Abwehr dazu, dass eine Routine-Bewegung blockiert wird und Bewegungsproben erschwert werden.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Deckung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Für die allermeisten, nicht-kugelsicheren und generell nicht-artifizierten Charaktere ist der einzig sinnvolle Schutz gegen Beschuss, in Deckung zu gehen.</Content>
				<Br />
				<Content>Eine massive Betonwand zwischen sich und dem Gegner zu bringen ist schlicht effektiver als jede Rüstung – und deutlich billiger.</Content>
				<Br />
				<Content>Deckung kann vieles sein: eine umgeworfene Kiste, ein geparktes Fahrzeug, eine Mauerecke oder ein schwerer Metalltisch. Entscheidend ist nicht, wie groß die Deckung ist, sondern wie gut sie Beschuss standhält. </Content>
				<Br />
				<Content>Einfache Türen, Sichtschutz oder dünnwandige, leere Kisten reichen nicht aus – sie mögen den Blick versperren, aber keine Kugel. </Content>
				<Br />
				<Content>Wer hinter Deckung kämpft, verändert auch seine Haltung im Kampf. Anstatt frei zu agieren</Content>
				<Content>, arbeitet der Charakter mit seiner Umgebung – lugt hervor, zieht sich zurück, wartet auf den richtigen Moment. Diese erhöhte Aufmerksamkeit macht ihn schwerer zu überraschen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schutzschicht: Deckung funktioniert wie eine zusätzliche Panzerung, die jedoch zuerst durchdrungen werden muss. Größe und Modulklasse der Deckung werden durch die SL festgelegt. Erst wenn der Durchschlag eines Angriffs die Deckung überwindet, trifft er auf die eigene Panzerung des Charakters.</Content>
				<Br />
				<Content>Abwehr: Befindet sich der Charakter am Ende seiner Handlungsphase in Deckung, erhält er 1 Punkt Abwehr.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 2">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 32" Name="Anker 32" Hidden="false" DestinationUniqueKey="20675" />
				<Content>Monitore und Trefferpunkte</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 123" Name="Anker 123" Hidden="false" DestinationUniqueKey="18564" />
				<Content>Um einen Gegner zu besiegen, sollte man so schnell wie möglich seinen Monitor füllen. </Content>
				<Br />
				<Content>Trefferpunkte stellen eine abstrakte Messung wie viel ein Charakter, eine Maschine oder ein System ertragen kann, bevor es aufgibt. Die Anzahl der angekreuzten Kästchen zeigt den Grad an Verletzungen, Beschädigung bzw. Korruption an, die bereits erlitten wurden. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Trefferpunkte (TP)</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>TP werden durch </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Kästchen</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> dargestellt, welche angekreuzt werden, wenn der Charakter oder der Gegenstand Schaden erleidet. Charaktere und Gegenstände haben TP in Höhe ihrer Größe.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker" Name="Anker" Hidden="false" DestinationUniqueKey="23082" />
				<Content>Schaden</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schaden ist der Gegenspieler zu Trefferpunkten und entsprechen der Anzahl an abgekreuzten TP.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Monitore sagen aus, wie schwer es ist, einer Entität ihre Fähigkeiten zu nehmen, ohne dabei strukturellen/vitalen Schaden anzurichten.</Content>
				<Br />
				<Content>Wie viele Kästchen die Monitore von Charakteren, Handlangern, Maschinen und Systemen haben, hängt von verschiedenen Spielwerten ab. Charaktere benutzen Konstitution und Geschick, um die Größe ihrer Monitore zu ermitteln. Handlanger ermitteln ihre Monitore größtenteils durch ihre Kompetenz, Maschinen durch ihre eigene Größe oder Modulklasse.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FillColor="Color/C=100 M=68 Y=0 K=55" FontStyle="Expanded Book" PointSize="16" Tracking="75">
				<Properties>
					<Leading type="unit">13</Leading>
					<AppliedFont type="string">Bebas Neue Pro</AppliedFont>
				</Properties>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenüberschrift span" SpaceBefore="14.173228346456694">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Werte von Monitore ermitteln</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabelle Span">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Table Self="u9aa53id96c7" HeaderRowCount="1" FooterRowCount="0" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" BodyRowCount="4" ColumnCount="4" AppliedTableStyle="TableStyle/Standardtabelle" TableDirection="LeftToRightDirection">
					<Row Self="u9aa53id96c7Row0" Name="0" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleRowHeight="19.888555211345043" />
					<Row Self="u9aa53id96c7Row1" Name="1" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="16.549972534179688" />
					<Row Self="u9aa53id96c7Row2" Name="2" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="16.549972534179688" />
					<Row Self="u9aa53id96c7Row3" Name="3" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="16.549972534179688" />
