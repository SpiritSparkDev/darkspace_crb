				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>)</Content>
				</CharacterStyleRange>
			</CrossReferenceSource>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Trefferpunkte widerherstellen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Der Einsatz von Sanitätern an den Frontlinien hat eine lange, traurige Tradition. Ging es bis vor wenigen Jahrhunderten noch ums blanke Überleben, ist die Notfallmedizin an einem Punkt angekommen, an dem ein verwunderter Soldat bereits nach wenigen Momenten wieder in den Kampf geschickt werden kann.</Content>
				<Br />
				<Content>Solange seine Wunden nicht zu schwer sind, sind Stims und andere Notmedikamente kleine Wundermittel bei der Behandlung von verschiedenen Verletzungen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aHandlungsHeader">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Durchbeißen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aHandlungsfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Routine-Bearbeitung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Wirkung: Der Charakter darf 1W10 Stress auf sich nehmen, um 3 Schaden von beliebigen Monitoren zu heilen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Sanitäter</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Im Kampf kann ein Sanitäter versuchen, einen anderen Charakter zu heilen (siehe </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" />
			<CrossReferenceSource Self="ud96dd" AppliedFormat="u9f" Name="Hyperlink 72" Hidden="false" AppliedCharacterStyle="n">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>Heilen und Versorgen S. </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" PageNumberType="TextVariable">
					<TextVariableInstance Self="ud96dc" Name="&lt;?AID 001b?&gt;TV XRefPageNumber" ResultText="92" AssociatedTextVariable="dTextVariablen&lt;?AID 001b?&gt;TV XRefPageNumber" />
				</CharacterStyleRange>
			</CrossReferenceSource>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>).</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 2">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 126" Name="Anker 126" Hidden="false" DestinationUniqueKey="18567" />
				<Content>Andere Gefahren</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Es kommt vor, dass Schaden nicht von einem Angriff stammt, sondern weil etwas Schweres auf den Charakter herunterfällt, der Charakter ein Stromkabel anfasst, Feuer fängt oder auf andere Weise droht, sich zu verletzen. Daher folgt eine Tabelle für die Spielleitung mit Beispielen für Schadenswerten.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schaden und Mods</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Mods können auch auf das Ergebnis von Schaden angewendet werden. So können Gefahren durch die Spielleitung an die Situation angepasst werden. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Unbegrenzte Aktivierungen: Schaden, der durch Umwelteinflüsse, wie Feuer, Strom oder einen Sturz, verursacht werden, können eine ihrer Mods beliebig oft, bis zu einem Maximum gleich ihrer MK aktivieren.</Content>
				<Br />
				<Content>Vielfältige Mods: Die Spielleitung kann frei festlegen, wie viele Mods eine Schadensquelle hat. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 127" Name="Anker 127" Hidden="false" DestinationUniqueKey="18568" />
				<Content>Schaden durch Umwelt</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Die häufigste Ursache für die Anwendung von Schadenspools sind umweltbedingte Situationen. Darunter fallen Brände, Stromschläge, Strahlung und Fallschaden.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Handlungsphase: Umweltschäden greifen am Ende einer Runde alles an, die in Reichweite des Umweltschadens ist.</Content>
				<Br />
				<Content>Treffer: Schaden durch Umwelt trifft automatisch immer den Defensivmonitor mit dem kleinstmöglichen Ergebnis.</Content>
				<Br />
				<Content>Würfelpool: Umweltschäden haben einen Würfelpool gleich ihrer Größe oder Modulklasse.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenüberschrift">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Umweltschaden</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabelle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
