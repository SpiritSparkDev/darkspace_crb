		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Vital</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Jeder Charakter, Handlanger, Maschine und System hat einen Vitalmonitor mit mindestens einem Kästchen. Jemand oder etwas ohne Vital-Monitor.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Außer Gefecht</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ist der Vital-Monitor komplett gefüllt, können Charaktere und Handlanger keine Handlungen mehr durchführen. Sie schweben in Lebensgefahr.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Systeme stürzen ab. Beide müssen in einer Ruhephase mit dem Prozess Bauen mit MK² x 10 KP wieder aufgesetzt werden.</Content>
				<Br />
				<Content>Maschinen gehen kaputt und müssen repariert werden.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Interaktion</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Der Interaktionsmonitor zeigt an, ob der Charakter, Handlange, die Maschine oder das System noch handlungsfähig sind. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Verringerte Handlungsphase</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ist der Interaktionsmonitor mindestens halb gefüllt, verringert sich die Handlungsphase des Charakters, Handlangers, der Maschine oder des Systems um 1 AE. </Content>
				<Br />
				<Content>Ist der Interaktionsmonitor vollständig gefüllt, verringert sich die Handlungsphase um 2 AE. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Mobilität</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ein Charakter, Handlanger oder Maschine, die sich fortbewegen kann, muss einen Mobilitätsmonitor haben.</Content>
				<Br />
				<Content>Stationär: Eine Maschine ohne Mobilitätsmonitor ist immobil und kann sich nicht bewegen. Das können statische Abwehranlagen, aber auch Ausrüstung und Gebäudeteile wie Türen sein.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schwere Bewegungen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ein Charakter, Handlanger oder eine Maschine (mit Mobilitätsmonitor), deren Mobilitätsmonitor komplett gefüllt ist, erleidet bei jeder </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Inline-Probe">
				<Content>Bewegung</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> 1 Punkt Stress. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Defensiv</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schutzlos</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ist der Defensivmonitor eines Charakters, Handlangers, einer Maschine oder Systems gefülltem, ist dessen Abwehr komplett durchbrochen. </Content>
				<Br />
				<Content>Alle weiteren Angriffe gegen den Charakter erhalten +3 auf ihr Ergebnis.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 125" Name="Anker 125" Hidden="false" DestinationUniqueKey="18566" />
				<Content>Kampfunfähig</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Kampfunfähigkeit kann durch zu viel Schaden, zu hohen Stress oder Drogen ausgelöst werden. Andere, sehr viel harmlosere Gründe sind aber auch Schlaf oder eine schlicht deakvierte Maschine.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Kampfunfähig: Ein Charakter oder eine Maschine wird Kampfunfähig, wenn zwei ihrer Monitore gefüllt sind. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ein kampfunfähiger Charakter oder eine kampfunfähige Maschine nimmt nicht länger an der Initiative teil. </Content>
				<Br />
				<Content>Es dürfen keine Handlungen mehr durchgeführt werden. </Content>
				<Br />
				<Content>Ein Charakter gilt als bewusstlos oder nahe Bewusstlosigkeit und eine Maschine reagiert nicht mehr und verschwindet auch im Cortex.</Content>
				<Br />
				<Content>Kampfunfähige Maschinen können nicht Ziel einer Cortex-Handlung werden.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schnelle Einsatzbereitschaft: Sobald die Ursache für die Kampfunfähigkeit beseitigt (z.B. wiederherstellen von TP) wird, ist der Charakter bzw. die Maschine nicht länger Kampfunfähig und kann </Content>
			</CharacterStyleRange>
