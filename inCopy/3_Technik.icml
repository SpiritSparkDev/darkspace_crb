					</Cell>
					<Cell Self="u9a217id1a32i5" Name="2:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="0" TextBottomInset="4" TextRightInset="0" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="0" TopInset="4" RightInset="0" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Datapad: Aktuelles Modell mit schneller Reaktionszeit und Sonderfunktionen.</Content>
								<Br />
								<Content>Pistole: Standardwaffe mit elektrischem Zünder und Zielcomputer.</Content>
								<Br />
								<Content>Implantat: Klinik-Standard für leistungssteigernde Implantate.</Content>
							</CharacterStyleRange>
