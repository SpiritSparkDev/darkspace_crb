					</Cell>
					<Cell Self="u9a217id1a32ia" Name="1:4" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Fortschrittlich</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1a32ib" Name="2:4" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="0" TextBottomInset="4" TextRightInset="0" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="0" TopInset="4" RightInset="0" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Datapad: Handliches Terminal mit quantenbasierter Rechenleistung und hochmodernen Funktionen. </Content>
								<Br />
								<Content>Pistole: Waffe mit fortschrittlichen Technologien wie Magnetbeschleuniger und künstlicher Intelligenz. </Content>
								<Br />
								<Content>Implantat: Bionisches Implantat mit erhöhter Reaktionsgeschwindigkeit und Sensibilität.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1a32ic" Name="0:5" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>5</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1a32id" Name="1:5" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>High-Tech</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1a32ie" Name="2:5" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="0" TextBottomInset="4" TextRightInset="0" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="0" TopInset="4" RightInset="0" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Datapad: Datapad mit hocheffizienten Bauteilen und unübertroffener Rechenleistung.</Content>
								<Br />
								<Content>Pistole: Das Modernste, was derzeit mit Werkstofftechnologien, Ballistik und Energiesystemen möglich ist.</Content>
								<Br />
								<Content>Implantat: Kybernetische Implantate aus dem besten, was die Materialwissenschaft und medizinische Robotik zu bieten hat.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
				</Table>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" ParagraphBreakType="NextColumn">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 2">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Handlungen mit Gegenständen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Oft werden Fertigkeitsproben mit Gegenständen durchgeführt. Welcher Gegenstand mit welcher Fertigkeit benutzt wird, ergibt sich dabei oft aus der Situation heraus und wird von der Spielleitung festgelegt.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Physisch vs. Digital</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Physische Gegenstände existieren als materielle Objekte. Sie haben Masse, eine Größe und einen festen Ort. Sie können beschädigt, repariert, getragen oder zerstört werden. Waffen, Panzerungen, Werkzeuge, Sensoren oder Maschinen sind in der Regel physisch – selbst dann, wenn sie hochkomplexe Elektronik enthalten.</Content>
				<Br />
				<Content>Digitale Gegenstände existieren ausschließlich als Daten, Prozesse oder Signale. Sie haben keine eigene Masse und keinen festen Ort, sondern werden auf Trägern, in Netzwerken oder innerhalb eines Cortex ausgeführt. Software, digitale Karten, KI-Instanzen, Kontrollprogramme oder virtuelle Werkzeuge fallen in diese Kategorie.</Content>
				<Br />
				<Content>Spielmechanisch ist diese Unterscheidung entscheidend, da physische und digitale Gegenstände auf unterschiedliche Weise beeinflusst, angegriffen und modifiziert werden. Ein physischer Gegenstand kann beschädigt oder blockiert werden, ein digitaler Gegenstand dagegen manipuliert, überschrieben oder isoliert.</Content>
				<Br />
				<Content>Oftmals besteht etwas aus beiden Ebenen gleichzeitig: Ein physischer Sensor erzeugt digitale Daten, eine digitale KI steuert eine physische Maschine. Die Einteilung legt fest, auf welcher Ebene eine Handlung ansetzt.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Autonom vs. Reaktiv</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Neben der Frage, wo bzw. wie ein Gegenstand existiert, ist ebenso wichtig, wie er handelt. Deshalb wird jeder Gegenstand zusätzlich danach unterschieden, ob er autonom oder reaktiv ist.</Content>
				<Br />
				<Content>Reaktive Gegenstände führen ausschließlich das aus, wozu sie unmittelbar angewiesen werden. Sie besitzen keine eigene Entscheidungslogik, keine Ziele und keine Initiative. Ein reaktiver Gegenstand wartet auf Eingaben, Befehle oder Auslöser und setzt diese exakt um. Die meisten Maschinen, Werkzeuge, Waffen und einfachen Systeme fallen in diese Kategorie – unabhängig davon, ob sie physisch oder digital sind.</Content>
				<Br />
				<Content>Autonome Gegenstände können selbstständig handeln. Sie verfügen über eine interne Entscheidungslogik, bewerten Situationen und treffen eigene Entscheidungen innerhalb ihres Funktionsrahmens. Autonome Systeme können Ziele priorisieren, auf Veränderungen reagieren und Handlungen auslösen, ohne direkt gesteuert zu werden. Dazu zählen komplexe Maschinen, fortgeschrittene KIs, Drohnen oder vernetzte Kontrollsysteme – und Menschen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Kategorien von Gegenständen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Gegenstände haben, je nach Kategorie, unterschiedliche Arten von Handlungen, die mit ihnen typischerweise durchgeführt werden können. Sensoren sind zum Beispiel nur für Analyseen und Vermeidungen zu gebrauchen, während ein Werkzeug Modifikationen, Steuerungen und Analyseen durchführen kann.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenüberschrift">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Übersicht: Kategorien von Gegenständen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
