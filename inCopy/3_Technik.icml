		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Sprengwaffen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Sprengradius: Sprengwaffen jeder Art erzeugt eine Explosion, mit einem Wirkbereich, der den idealen Reichweiten von Fernkampfwaffen gleicht, allerdings Modulklasse und nicht größe als Maßstab benutzt.</Content>
				<Br />
				<Content>Schaden: Sprengwaffen addieren innerhalb ihres Sprengradius ihre Modulklasse auf ihren Schaden.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenüberschrift">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Beispiele für Sprengwaffen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
