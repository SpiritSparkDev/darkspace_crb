				</Table>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Digitale Waffen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bei Terminals handelt es sich um den Sammelbegriff für tragbare oder stationäre Computer, wie er in der menschlichen Gesellschaft schon seit Jahrhunderten in Gebrauch ist. Der Begriff Datapad wird für handelsübliche mobile Geräte verwendet.</Content>
				<Br />
				<Content>Jedes Terminal verfügt über einen Bildschirm, Holo-Emitter zur Darstellung einer holografischen Tastatur, Bildern und Videos, Steckplätze für standardisierte Speichermedien und Anschlüsse für Peripheriegeräte.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>High-Tech-Schaden: Terminals haben immer den Kern „High Tech Waffe“ und addieren daher ihre Modulklasse auf ihre Größe, um Schaden zu verursachen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenüberschrift">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Werte von Terminals</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
