					<Cell Self="u9a217id1b15i1" Name="1:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Stim-Injektor</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15i2" Name="0:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>2</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15i3" Name="1:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<ParagraphDestination Self="ParagraphDestination/Anker 159" Name="Anker 159" Hidden="false" DestinationUniqueKey="18629" />
								<Content>MedKit</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15i4" Name="0:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>3</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15i5" Name="1:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>MedBag</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15i6" Name="0:4" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>4</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15i7" Name="1:4" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>MedStation</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15i8" Name="0:5" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>5</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15i9" Name="1:5" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Krankenkapsel</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15ia" Name="0:6" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>6</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u9a217id1b15ib" Name="1:6" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Behandlungsraum</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
				</Table>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aHandlungsHeader">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 37" Name="Anker 37" Hidden="false" DestinationUniqueKey="22265" />
				<Content>Heilen und Versorgen	10 + 2 x Wunden</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aHandlungsfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bearbeitung 	</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bildung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Wenn es um Leben oder Tod geht, reicht manchmal schon ein Stim und ein guter Druckverband, um das Blut drinnen und den Patienten bei Bewusstsein zu halten.</Content>
				<Br />
				<Content>In anderen Fällen ist schon etwas mehr Wissen und bessere Ausstattung von nöten. </Content>
				<Br />
				<Content>Heilung von Verletzungen dauert ohne medizinische Versorgung lang und kann mit Komplikationen verbunden sein.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schwierigkeit: Die Schwierigkeit beginnt bei 10 und erhöht sich um 2 für jede Wunde bzw. jeden verlorenen TP (der Defensivmonitor wird dafür ignoriert).</Content>
				<Br />
				<Content>Erfolg: Der Charakter setzt die TP aller Monitore des Patienten auf die Größe des Medkits, falls er vorher weniger hatte.</Content>
				<Br />
				<Content>Prozess: Der Charakter stellte alle TP des Patienten wieder her. </Content>
				<Br />
				<Content>Misserfolg: Der Charakter heilt keine TP.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aHandlungsHeader_L">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Operation	10 + 2 x Konstitution</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aHandlungsfeld_L">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bearbeitung</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>	Bildung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegel_Lore">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Durch eine Operation können schwerste immersive Eingriffe in den menschlichen Körper vorgenommen werden. Gewebe kann entfernt oder hinzugefügt werden, schwere Verletzungen wie Knochenbrüche oder beschädigte Organe werden repariert oder es werden kybernetische Komponenten eingepflanzt.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Erfolg: Ein Charakter kann durch eine Operation eine der folgenden Effekte erhalten:</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Gewebereparatur: Für jede Zeitstufe heilt der Charakter 1 Schaden. Erleidet der Charakter erneut Schaden, bevor er vollständig genesen ist, wird dieser Effekt agebrochen.</Content>
				<Br />
				<Content>Entstellung korrigieren: Eine Entstellung und alle damit verbundenen Nachteile werden entfernt. Der Charakter erleidet 1 Schaden auf seinem Vitalmonitor.</Content>
				<Br />
				<Content>Handicap entfernen: Der Charakter verliert ein beliebiges Handicap. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Misserfolg: Der Charakter erhält keinerlei positive Effekte durch die Operation.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Wissenschaftliche Instrumente und Labore</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Neben der normalen Werkstatt, die mit der Technik-Fertigkeit verbunden ist, gibt es noch wissenschaftliche Instrumente und Labore.</Content>
				<Br />
				<Content>Diese funktionieren genau wie Werkzeug oder eine Werkstatt, mit dem einzigen Unterschied, dass sie vornehmlich für die Herstellung von chemischen, biochemischen und nanotechnischen Erzeugnissen verwendet werden. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Fertigkeiten: Wissenschaftliche Instrumente und Labore werden mit Bildung verwendet.</Content>
				<Br />
				<Content>Hobbylabor: Mit wissenschaftlichen Instrumenten und Laboren können die Aktionen “Bauen und Reparieren” für Chemikalien, Drogen, Sprengstoffe und ähnliches verwendet werden.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Chems</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Chems sind eine vielfältige Kategorie von Substanzen, die Medikamente und Drogen umfassen. Chems dienen verschiedenen Zwecken und können sowohl für Heilung und Stärkung als auch für verbesserte Fähigkeiten und verbotene Genüsse eingesetzt werden. </Content>
				<Br />
				<Content>Richtig angewendet, bieten sie eine Möglichkeit, die Grenzen des Körpers und des Geistes zu erforschen, bergen jedoch auch Risiken und Nebenwirkungen. </Content>
				<Br />
				<Content>Der Gebrauch von Chems kann süchtig machen und unerwartete Folgen haben. Medikamentenmissbrauch und Drogenabhängigkeit sind trauriger Alltag für Junkies, gestresste Studenten und Anzugträger. Hinzu kommen verhnittene Mittel, die mit Giftstoffen kontamiert sind, meisten um den Stoff zum Strecken und den Gewinn für den Dealer zu maximieren. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Herstellung und Wirkung von Chems</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Grundsubstanz: Ein Chem, das mit KP erzeugt wird, kann mit je 100 EP eine Wirkung erhalten. Für je 100 EP verringert es Stress, e</Content>
				<Content>rzeugt eine Leistungssteigerung oder verleiht dem Charakter eine Bewussseinserweiterung (siehe unten).</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Entspannung: Das Chem verringert den Stress des Charakters um seine Modulklasse.</Content>
				<Br />
				<Content>Leistungssteigerung: Der Charakter erhält [MK] Würfel, die er während der Wirkung des Chems (eine Szene) zu beliebige Proben hinzufügen darf.</Content>
				<Br />
				<Content>Bewusstseinserweiterung: Der Charakter erhält eine Mod, die bei der Erstellung des Chems festgelegt werden muss. Diese Mod darf er [MK]mal kostenlos aktivieren und zahlt danach mit Stress nach den normalen Regeln. Die Mod verschwindet nach einer Szene.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Beispiele%3aBeispiel">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Beispiel: Studenten stehen zuweilen unter viel Druck. Um ihre Mod „Detailarbeit“ für eine Bildungsprobe nochmal einzusetzen, schluckt Emilia noch eine Tabelle (MK 3), die ihr 2 Routinen und 1 Würfel zur Verfügung stellt. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Einnahme von Chems</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Chems dürfen auf beliebigem Wege eingenommen werden. Wie genau wird bei der Erstellung festlegt. Häufige Einnahmevektoren sind orale Aufnahme in fester oder flüssiger Form, Einatmung oder direkte Injektion.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aHandlungsHeader_L">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Abhängigkeit	10 + MK x 2</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aHandlungsfeld_L">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Willenskraft	Steuerung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Die meisten Drogen erzeugen eine chemische Kaskade im Hirn des Konsumenten, das eine schnelle Abhängig induziert. Dieselben Stoffe, die eine verbesserte Konzentration, schnellere Reflexe oder einfach ein generelles Hochgefühl erzeugen, werden dann für die Hirnchemie unverzichtbar.</Content>
				<Br />
				<Content>Werden Chems falsch eingenommen oder die Dosierung verpatzt, können sie sogar den gegenteiligen Effekt haben. Zusammenbrüche, Erbrechen, Schüttelfrost und psyschiches Trauma sind nur ein kurzer Auszug einer langen Liste.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Sucht: Zu Beginn jeder Ruhephase, nachdem der Charakter ein Chem zu sich genommen hat, </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>muss</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> der Charakter ein weiteres Chem mit derselben Modulklasse zu sich nehmen, die Probe bestehen oder er beginn unter einem Entzug zu leiden.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Entzug: Der Charakter ist mental und physisch nahezu am Ende. Er erleidet [MK] Punkte Stress und kann während der Ruhephase keinen Stress heilen. </Content>
				<Br />
				<Content>Abhänigkeit: Abhängigkeit wird wie ein allgemeines Handicap behandelt (siehe auch </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" />
			<CrossReferenceSource Self="ud1b29" AppliedFormat="u9f" Name="Hyperlink 70" Hidden="false" AppliedCharacterStyle="n">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>Handicaps S. </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" PageNumberType="TextVariable">
					<TextVariableInstance Self="ud1b28" Name="&lt;?AID 001b?&gt;TV XRefPageNumber" ResultText="65" AssociatedTextVariable="dTextVariablen&lt;?AID 001b?&gt;TV XRefPageNumber" />
				</CharacterStyleRange>
			</CrossReferenceSource>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>).</Content>
				<Br />
				<Content>Erfolg: Ein Charakter der noch nicht abhängig ist, bleibt nicht abhängig, egal ob er die Chem während der Ruhephase einnimmt oder nicht. Ein Charakter, der bereits abbhängig ist, kann während der Ruhephase dem Druck wiederstehen, die Chem weiter einzunehmen. Die Kosten, die Abhängigkeit abzulegen, verringern sich um 10 EP (bis zu einem Minimum von 10 EP).</Content>
				<Br />
				<Content>Misserfolg: Ein Charakter der noch nicht abhängig war wird es jetzt. Ein Charakter, der bereits abhängig war, muss die Chem zu sich nehmen. Da beim Versuch, der Abhängig zu widerstehen, davon ausgegangen wird, dass die Chem längere Zeit nicht eingenommen wurde, verstärkt sich der Stress-Zuwachs durch den Entzug um das doppelte.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Toxine</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Toxine sind gefährliche Stoffe, die auf schädliche Weise in den Stoffwechsel des Charakters eingreifen. Verklumpungen in Blutgefäßen, Zelltot oder Nervenstörungen sind einige populäre Varianten, jemand auszuschalten.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Toxine herstellen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Grundsubstanz: Ein Toxin, das mit KP erzeugt wird, kann mit je 100 EP eine Wirkung erhalten. Für je 100 EP verursacht es Stress oder ein Handicap. Schaden kann je nach Monitor ebenfalls gekauft werden. Schaden auf dem Mobilitätsmonitor kosten 100 KP, Schaden auf dem Interaktionsmonitor 150 KP und Schadena auf dem Vitalitätsmonitor 200 KP.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Beispiele%3aBeispiel">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ein Toxin, dass nach der Bestimmung der herzustellenden Menge und MK noch 300 KP übrig hat, kann dadurch zum Beispiel Stress und zwei Handicaps erzeugen. Oder verdoppelten Schaden und Stress.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Verbreitung: Toxine verbreiten sich im Körper. Zu Beginn einer Ruhephase und am Ende jeder Zeitstufe während der Ruhephase muss der Charakter eine Fitness-Probe (10 + MK x 2 des Toxins) ablegen. Bei einem Misserfolg wirkt ein Toxin, das Schaden oder Stress verursacht, erneut mit halber (aufrunden) Intensität. Toxine die Handicaps verursachen, erhöhen die Kosten, das Handicap zu entfernen um 25 EP.</Content>
				<Br />
				<Content>Aufnahme: Ein Toxin, dass über den Magen verabreicht wird, muss aktiv vom Ziel gegessen werden. Das Ziel darf eine Wahrnehmung-Probe (10 + MK x 2) ablegen, um das Gift zu schmecken.</Content>
				<Br />
				<Content>Kontakt: Wird ein Kontakt-Gift auf Waffen oder Munition aufgetragen, muss genug Schaden beim Angriff erzeugt werden, um mindestens 1 TP Schaden anrichten zu können. Dann gilt das Gift als appleziert.</Content>
				<Br />
				<Content>Gas: Befindet sich ein Ziel in einem Bereich, in dem das Gift in der Luft liegt, kann sich das Ziel mit Atemsystemen schützen. Atemsysteme mit einer kleineren MK als das Gift werden durchdrungen.</Content>
				<Br />
				<Content>Injektion: Für eine Injektion muss der Charakter das Ziel mit einem Injektor den Vital-, Interaktions oder Mobilitätsmonitor des Ziels treffen. Der Durchschlag des Injektors muss mindestens die Panzerung des Ziels übertreffen oder mindestens 1 Schaden anrichten.</Content>
				<Br />
				<Content>Metabolismu: Toxine sind wirkungslos gegen Ziele, die keinen Metabolismus haben, also gegen Maschinen, Androiden und dergleichen. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Wirkungen von Toxinen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegel_Lore">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Toxine können verschiedene Auswirkungen auf den Körper haben. die gängisten drei Varianten sind direkter Schaden, Stress und Handicaps. </Content>
				<Br />
				<Content>Schaden bildet Toxine ab, die Zelltod verursachen, wie zum Beispiel Nervengifte. Toxine, die Stress verursachen tun dies durch direkte Halluzinogene Wirkung, umgangssprachlich auch einen schlechten Tripp. Toxine, die keine der beiden genannten Varianten abdecken verursachen stattdessen ein oder mehrere Handicaps. Wie lange die Wirkung anhält und Schaden nicht geheilt, Stress nich verringert und Handicaps nicht entfernt werden kann, hängt von der Modulklasse ab.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FillColor="Color/C=100 M=68 Y=0 K=55">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Dosis macht das Gift: Beim Verabreichen kann der Charakter festlegen, wie viel Gift er benutzen will und legt damit eine Größe fest.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schaden: Das Toxin richtet [MK + Größe] Schaden an. Der betroffene Monitor wird beim erschaffen des Toxins festgelegt.</Content>
				<Br />
				<Content>Stress: Ein Toxin erzeugt beim Ziel [MK + Größe] Punkte Stress. </Content>
				<Br />
				<Content>Handicap: Das Toxin erzeugt ein Handicap, das der Charakter von nun an hat. Falls der Charakter bereits drei Handicaps hat, erhöht das Toxin die Kosten für alle Handicaps um 25 EP.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Sprengstoffe</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Sprengstoffe werden für alle möglichen Anwendungen produziert, egal ob militärisch oder zivil. Aus offensichtlichen Gründen ist es jedoch nicht ganz einfach an größere Mengen heranzukommen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Herstellung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegel_Lore">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Söldner, Kriminelle, Terroristen und unvorsichte Teenager stellen ihren oft Sprengstoff selbst her. Viele Sprengstoffe sind chemisch nicht kompliziert und detailierte Anleitungen geistern überall durch den Cortex.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FillColor="Color/C=100 M=68 Y=0 K=55">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Zündung: Bei der Herstellung wird ein Zündung festgelegt: Thermisch, chemisch, elektronisch oder mechanisch.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Thermische Zündung: Sobald der Sprengstoff droht durch Hitze Schaden zu nehmen, explodiert er.</Content>
				<Br />
				<Content>Chemische Zündung: Sobald der Sprengstoff mit einer festgelegten Chemikalie (die mindestens dieselbe MK haben muss, wie der Sprengstoff), explodiert sie.</Content>
				<Br />
				<Content>Elektronische Zündung: Wird einem Gerät, das mit dem Sprengstoff verbunden ist, via Cortex ein Befehl geben, explodiert er.</Content>
				<Br />
				<Content>Mechanische Zündung: Sobald der Sprengstoff droht Schaden zu nehmen oder ein Mechanismus mit einem Routine bedient wird, explodiert er.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Anwendung von Sprengstoffen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Hat man den Sprengstoff und einen Zünder geht es nur noch darum, etwas passendes zu finden, was man in die Luft jagen will.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Zündung: Sobald der Zünder mit einem Routine ausgelöst wird, explodiert der Sprengstoff und richtet in seinem Sprengradius den angegeben Schaden an.</Content>
				<Br />
				<Content>Sprengradius: Sprengstoff erzeugt eine Explosion, mit einem Wirkbereich gleich ihrer Modulklasse² x Größe² in Metern.</Content>
				<Br />
				<Content>Schaden: Der Sprengsatz richtigen [Größe + MK] Schaden im Sprengradius an.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FillColor="Color/Black">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 2">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Gegenstände erstellen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schritt 1: Konzept</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Überlege dir, was du erstellen möchtest. Wie soll es funktionieren und was für einen nutzen soll es dem Charakter bringen und wie soll seine Spielmechanik funktionieren. Stimme dich dazu auch unbedingt mit der Spielleitung ab.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schritt 2: Größe und Modulklasse</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Die wichtigsten drei Spielwerte eines neuen Gegenstandes, sind seine Größe, Modulklasse und Kern. In deinem Kopf hat dein neuer Gegenstand vermut</Content>
				<Content>lich bereits ein ungefähres Aussehen. Gleiche deine Vorstellung mit der Größentabelle ab und wähle einen passenden Wert.</Content>
				<Br />
				<Content>Für die Modulklasse kannst du ebenfalls die Modulklasse-Tabelle konsultieren. Dabei ist es wichtig zu verstehen, dass die Modulklasse die Qualität des Gegenstandes relativ zu ähnlichen Gegenständen misst. Ein MK 1 Medkit ist eine Tasche mit Desinfektionsmitteln und Bandagen, ein MK 5 Medkit enthält z.B. medizinische Mini-Drohnen und Kunsthaut aus der Sprühdose.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Weitere Spielwerte für Maschinen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Maschinen haben neben Größe und Modulklasse auch noch eigene Begabungen: Bots, Leistung, Servos und Sensoren. Auch diese müssen durch KP gekauft werden. Haben dieselbe Kosten wie Begabungen von Charakteren, nur eben in Form von KP und nicht EP.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schritt 3: Mods</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Füge nach belieben weitere Mods hinzu. Ein Gegenstand kann nicht mehr als Mods haben, als seine Modulklasse, den Kern eingeschlossen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schritt 4: Berechnung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ermittle die notwendigen KP. In der Tabelle KP-Kosten für Ausrüstung sind die kompletten Kosten für die entsprechenden Größen und Modulklassen fertig ausgerechnet. Gegenstände beginnen an der unteren Masse-Grenze ihrer Größe.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Mathematisch genau: Die exkte Formel zum berechnen von KP lautet:</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aSpecial-Feld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" HorizontalScale="90">
				<Content>5 x ( MK×(MK+1)×(2×MK+1) / 6 ) x Masse</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenüberschrift span">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>KP-Kosten für Ausrüstung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabelle Span">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
