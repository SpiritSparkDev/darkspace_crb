		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Erfolg: Die Bewegungsprobe des Ziels am Ende der Szene wird erschwert. Bei der nächsten Szene beginnt das Ziel mit einer bereits erschwerten Position.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Besondere Situationen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Mehrere Verfolger</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Gibt es mehrere Verfolger führt nur der vorderste Verfolger die Bewegungsprobe am Ende der Szene durch. Die anderen Verfolger können während der Szene Handlungen durchführen um den führenden Verfolger zu unterstützen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Mehrere Ziele</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Gibt es mehrere Ziele die gemeinsam fliehen führt nur das langsamste Ziel die Bewegungsprobe am Ende der Szene durch. Die schnelleren Ziele können während der Szene Handlungen durchführen um das langsamste Ziel zu unterstützen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Verfolgung zu Fuß vs. Fahrzeug</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ist ein Beteiligter zu Fuß und der andere in einem Fahrzeug verwendet der Charakter zu Fuß körperliche Fertigkeiten (Geschwindigkeit, Agilität, Kraft) während der Charakter im Fahrzeug Manövrieren verwendet.</Content>
				<Br />
				<Content>Der Streckenwert wird entsprechend der Umgebung angepasst – zu Fuß kann man durch enge Gassen und über Dächer die für Fahrzeuge unpassierbar sind.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Digitale Verfolgung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Eine Verfolgung kann auch digital stattfinden – ein Hacker versucht einem Sicherheitssystem zu entkommen oder ein KI-Agent jagt einen Eindringling durch ein Netzwerk. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Fertigkeiten: Es werden Logik und Technik statt körperlicher Fertigkeiten verwendet. </Content>
				<Br />
				<Content>Virtueller Streckenwert: Der Streckenwert repräsentiert die Komplexität des Systems.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Abbruch und Aufgabe</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ziel gibt auf: Das Ziel kann jederzeit aufgeben und sich stellen. Die Verfolgung endet sofort.</Content>
				<Br />
				<Content>Verfolger bricht ab: Der Verfolger kann die Verfolgung abbrechen wenn das Ziel zu weit entkommen ist oder der Aufwand zu hoch wird. Die Verfolgung endet und das Ziel entwischt.</Content>
				<Br />
				<Content>Unfall oder Kampfunfähigkeit: Wird ein Beteiligter kampfunfähig (Vitalmonitor voll) oder verunglückt (Fahrzeug zerstört) endet die Verfolgung sofort. Der kampfunfähige Beteiligte hat verloren.</Content>
			</CharacterStyleRange>
		</ParagraphStyleRange>
	</Story>
	<ColorGroup Self="ColorGroup/Basisfarben" Name="Basisfarben" IsRootColorGroup="false">
		<ColorGroupSwatch Self="u9c916ColorGroupSwatch1" SwatchItemRef="Color/C=100 M=68 Y=0 K=55" />
	</ColorGroup>
	<ColorGroup Self="ColorGroup/[Root Color Group]" Name="[Root Color Group]" IsRootColorGroup="true">
		<ColorGroupSwatch Self="u18ColorGroupSwatch3" SwatchItemRef="Color/Black" />
	</ColorGroup>
</Document>
