					<Row Self="u99560id9368Row6" Name="6" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="27.349972534179685" />
					<Row Self="u99560id9368Row7" Name="7" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="27.349972534179685" />
					<Row Self="u99560id9368Row8" Name="8" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="38.14997253417968" />
					<Row Self="u99560id9368Row9" Name="9" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="27.349972534179685" />
					<Row Self="u99560id9368Rowa" Name="10" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="54.61926387276236" />
					<Row Self="u99560id9368Rowb" Name="11" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="27.349972534179685" />
					<Column Self="u99560id9368Column0" Name="0" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleColumnWidth="66.61417322816533" />
					<Column Self="u99560id9368Column1" Name="1" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleColumnWidth="168.330708661508" />
					<Cell Self="u99560id9368i16" Name="0:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenkopf">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Verwende...</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i17" Name="1:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenkopf">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Wenn...</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i0" Name="0:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Größe</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i1" Name="1:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...das Ziel besonders groß oder schwer ist (z.B. eine massive Maschine oder eine riesige Tür)</Content>
								<Br />
								<Content>...einfache beschaffen ist, aber große Komponenten und Baugruppen hat</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i2" Name="0:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Modulklasse</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i3" Name="1:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...es sich um ein besonders komplexes Gerät handelt (z.B. eine Hochleistungswaffe oder ein Raumschiff)</Content>
								<Br />
								<Content>...das Gerät eine hohe Modulklasse hat, die seine Handhabung erschwert</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i4" Name="0:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Ausstrahlung</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i5" Name="1:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...der Charakter einer sozial mächtigen Figur gegenüber steht</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i6" Name="0:4" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="2" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Geschick</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i7" Name="1:4" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...das Ziel versucht auszuweichen oder sich windet.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i8" Name="0:5" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="6" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Konstitution</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i9" Name="1:5" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="4" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...sich das Ziel gegen die Probe mit körperlicher Kraft wehrt.</Content>
								<Br />
								<Content>...die physiologie das Ziels gegen die Probe arbeitet (z.B. bei Giften oder Drogen)</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368ia" Name="0:6" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="6" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Konzentration</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368ib" Name="1:6" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="4" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...das Ziel geistig überrumpelt werden soll.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368ic" Name="0:7" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="14" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Intelligenz</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368id" Name="1:7" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="4" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...das Ziel intellektuell besiegt werden soll.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368ie" Name="0:8" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="14" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Intuition</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368if" Name="1:8" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="4" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...das Ziel auf einer emotionalen oder unterbewussten Ebene beeinflusst werden soll.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i10" Name="0:9" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="14" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Kompetenz</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i11" Name="1:9" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="4" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...wenn das Ziel ein einfacher Handlanger ist.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i12" Name="0:10" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="14" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Verletzungen</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i13" Name="1:10" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="4" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...wenn Verletzungen behandelt werden sollen.</Content>
								<Br />
								<Content>...die Tatsache, dass das Ziel verletzt ist, die Aufgabe schwerer macht.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i14" Name="0:11" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="14" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Stress</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9368i15" Name="1:11" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="4" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>...wenn der Charakter mit enem vergangenen Trauma konfrontiert sieht.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
				</Table>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Manchmal muss der Charakter gegen seinen eigenen Körper oder Ausrüstung arbeiten. Dann wird der Widerstand aus Spielwerten des Charakters bestimmt. Verletzungen, die Größe von Ausrüstung beim Tragen und Stemmen, die Modulklasse komplexer Geräte, die sich nicht ganz einfach bedienen lassen, sind Beispiel für Spielwerte des Charakters, die einen Widerstand erzeugen können.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FillColor="Color/C=100 M=68 Y=0 K=55">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 2">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 50" Name="Anker 50" Hidden="false" DestinationUniqueKey="21533" />
				<Content>Stress</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Einige Herausforderungen, egal ob physisch oder psychisch gehen nicht spurlos am Charakter vorbei. Stress stellt dar, wie viel der Charakter schon ertragen musste. </Content>
				<Br />
				<Content>Ein Charakter kann theoretisch beliebig viel Stress auf sich nehmen, wird aber irgendwann als wimmerndes Häufchen Elend enden, wenn er nicht auf seine mentale Gesundheit achtet.</Content>
				<Br />
				<Content>Charaktere erhalten auf zwei Wegen Stress: Als Konsequenz eines herben Rückschlags oder selbst verursacht durch besonders anstrengende Handlungen. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Kollabieren: Der aktuelle Stress gibt an, bis wohin eine Probe als </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Erfolgsformate%3aPatzer">
				<Content>Kollaps</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> gewertet wird. Jedes Ergebnis dass gleich oder niedriger ausfällt, als der aktuelle Stress, ist ein </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Erfolgsformate%3aPatzer">
				<Content>Kollaps</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
				<Content> (S. 6)</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>.</Content>
				<Br />
				<Content>Trauma: Erreicht ein Charakter ein Stress-Level von 10, wird er traumatisiert. Zu Beginn der nächsten ##Ruhephase muss er sein Trauma unter 5 senken, oder erhält ein ##Handicap.</Content>
				<Br />
				<Content>Erholung: Stress wird während einer ##Ruhephase geheilt. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Stress auf sich nehmen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Manchmal reicht reine Fähigkeit nicht aus, um eine Situation zu meistern. Ein Charakter kann sich über seine eigenen Grenzen hinaus anstrengen – auf Kosten seiner mentalen Stabilität.</Content>
				<Br />
				<Content>Stress auf sich zu nehmen bedeutet, die letzten Reserven zu mobilisieren, Schmerz, Angst oder Überforderung bewusst in Kauf zu nehmen, um etwas zu erreichen, das eigentlich nicht mehr möglich sein sollte.</Content>
				<Br />
				<Content>Es ist für einen kurzen Moment ein Akt der Überwindung. Vielleicht muss der Charakter gegen einen Instinkt oder eine Emotion arbeiten oder etwas tun, dass so ganz und gar nicht seinem Wesen entspricht.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Vorteile und Kosten: Es wird ein beliebiger Vorteil aus der Tabelle „Vorteile durch Stress“ gewählt und angewandt. Danach werden die entsprechenden Punkte Stress eingetragen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenüberschrift">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 35" Name="Anker 35" Hidden="false" DestinationUniqueKey="20673" />
				<Content>Vorteile durch Stress</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabelle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Table Self="u99560id9379" HeaderRowCount="1" FooterRowCount="0" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" BodyRowCount="4" ColumnCount="2" AppliedTableStyle="TableStyle/Standardtabelle" TableDirection="LeftToRightDirection">
					<Row Self="u99560id9379Row0" Name="0" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleRowHeight="19.888555211345043" />
					<Row Self="u99560id9379Row1" Name="1" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="59.749972534179676" />
					<Row Self="u99560id9379Row2" Name="2" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="70.54997253417967" />
					<Row Self="u99560id9379Row3" Name="3" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="59.749972534179676" />
					<Row Self="u99560id9379Row4" Name="4" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" SingleRowHeight="48.94997253417968" />
					<Column Self="u99560id9379Column0" Name="0" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleColumnWidth="166.67716535433073" />
					<Column Self="u99560id9379Column1" Name="1" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" SingleColumnWidth="68.26771653534257" />
					<Cell Self="u99560id9379i8" Name="0:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenkopf">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Effekt</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i9" Name="1:0" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="5.669291338582678" TextLeftInset="5.669291338582678" TextBottomInset="5.669291338582678" TextRightInset="5.669291338582678" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Tabellenformate%3aTabellenkopf">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Stress</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i0" Name="0:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Würfelpool vergrößern: Der Charakter erhält +1W für seine aktuelle Probe pro Stress-Punkt. Der Charakter kann Stress nach und nach auf sich nehmen, um einzelne Würfel zu kaufen.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i1" Name="1:1" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>+1 pro Würfel</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i2" Name="0:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Handlungsphase verlängern: Der Charakter erhält pro Belastung 1 AE zusätzlich für seine Handlungsphase. Auf diese Weise kann die Handlungsphase maximal um 3 AE verlängert werden.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i3" Name="1:2" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>+1 pro AE</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i4" Name="0:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Handlungsphase an sich reißen: Der Charakter erhält die nächstmögliche Handlungsphase, unabhängig davon, wie viele AE er hat oder wie hoch seine Initiative ist.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i5" Name="1:3" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>+3</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i6" Name="0:4" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>Mods aktivieren: Es wird eine beliebige Mod aktiviert, egal ob eine Charakter-Mod oder eine Mod von Ausrüstung, die der Charakter benutzt.</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
					<Cell Self="u99560id9379i7" Name="1:4" RowSpan="1" ColumnSpan="1" CellType="TextTypeCell" TextTopInset="4" TextLeftInset="4" TextBottomInset="4" TextRightInset="4" ClipContentToTextCell="false" AppliedCellStyle="CellStyle/$ID/[None]" AppliedCellStylePriority="0" LeftInset="4" TopInset="4" RightInset="4" BottomInset="4" ClipContentToCell="false">
						<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
							<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
								<Content>1</Content>
							</CharacterStyleRange>
						</ParagraphStyleRange>
					</Cell>
				</Table>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3" SpaceBefore="19.84251968503937">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Stress erleiden</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Die Spielleitung kann festlegen, dass ein Charakter Stress erleidet. Stress wird nicht von etwas abgezogen, sondern baut sich auf. Manchmal schneller, manchmal langsamer und nicht immer hat ein Charakter Gelegenheit, dagegen etwas zu machen.</Content>
				<Br />
				<Content>Ein Charakter erleidet Stress durch alle möglichen Situationen. Einige davon sind offensichtliche Faktoren für Stress, aber Spielleitung und Spielende sollten sich gemeinsam weitere Stressfaktoren für Charakter und die Spielrunde ausdenken.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Standardformate%3aAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Gefährliche Konfrontation:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Ein intensiver Kampf oder eine gefährliche Begegnung mit einem übermächtigen Gegner.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Moralisches Dilemma:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Der Charakter muss eine schwierige Entscheidung treffen, die gegen seine eigenen Werte oder Prinzipien verstößt.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Verlust eines Verbündeten:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Der Tod oder die Verletzung eines engen Freundes, Verbündeten oder anderen Spielercharakters.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Zeitdruck:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Eine Mission muss unter extremem Zeitdruck abgeschlossen werden, und der Charakter fühlt sich überfordert.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Isolation:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Der Charakter verbringt eine längere Zeit alleine in einer gefährlichen oder unheimlichen Umgebung.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Verrat:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Ein Charakter wird von jemandem verraten, dem er vertraut hat.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Technisches oder körperliches Versagen:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Ausrüstung, Technologie oder die körperliche Leistungsfähigkeit des Charakters versagen im entscheidenden Moment.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Verfolgung:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Der Charakter wird über einen längeren Zeitraum gejagt oder verfolgt, ohne eine Pause zur Erholung.</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Konstante Überwachung:</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> Der Charakter steht unter ständiger Beobachtung und Kontrolle, was ihm kaum Raum für Fehler oder Freiheit lässt.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Dies sind nur allgemeine Beispiele. Zur Charaktererstellung werden unter anderem auch Laster und Tugenden für einen Charakter ermittelt, die ebenfalls genutzt werden können, um passende Stressfaktoren für einen Charakter zu ermitteln.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" ParagraphBreakType="NextColumn">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 2">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Handlungen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Eine Handlung beinhaltet einzelne Handgriffe, einige Gedanken oder eine schnelle Reaktion. Die Spielleitung benutzt Handlungen, wenn angedacht ist, diese in sehr kurzer Zeit (in einem Kampf innerhalb der eigenen Handlungsphase) aufzulösen. Bei einer Handlung wird nur ein Spielwert als Widerstand (eine Begabung, Modulklasse, Masse, etc.) verwendet oder von der Spielleitung festgelegt. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Jetzt oder nie: Handlungen müssen mit einem Versuch geschafft werden. Andernfalls müssen sie (falls möglich) in einen Prozess umgewandelt oder abgebrochen werden.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Routinen, Aktionen, Angriffe und Unterbrechungen</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Routinen, Aktionen und Angriffe werden vor allem im Bezug auf das Aktionspunkte-System benutzt, das Dark Space verwendet, um in einem Kampf, Verfolgungsjagt oder Infiltration die Reihenfolge von Charakteren abzubilden. </Content>
				<Br />
				<Content>Grob gesagt sind Routinen alle Handlungen, die keine Probe erfordern. Aktionen erfordern eine Probe und Angriffe erfordern eine Probe und haben ein Ziel. Unterbrechungen können nur eingesetzt werden, wenn der Charakter gerade nicht an der Reihe ist und werden benutzt, um sich selbst oder andere vor Angriffen zu schützen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Prozesse</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" />
			<CrossReferenceSource Self="ud9387" AppliedFormat="u9e" Name="Hyperlink 57" Hidden="false" AppliedCharacterStyle="n">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>Prozesse (S. </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" PageNumberType="TextVariable">
					<TextVariableInstance Self="ud9386" Name="&lt;?AID 001b?&gt;TV XRefPageNumber" ResultText="42" AssociatedTextVariable="dTextVariablen&lt;?AID 001b?&gt;TV XRefPageNumber" />
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>)</Content>
				</CharacterStyleRange>
			</CrossReferenceSource>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> beinhalten komplexe Abläufe, Aufgaben und berücksichtigen, dass man sich bei einem Problem schon mal zurücklehnen und darüber nachdenken muss. Prozesse werden während </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" />
			<CrossReferenceSource Self="ud9389" AppliedFormat="u9e" Name="Hyperlink 87" Hidden="false" AppliedCharacterStyle="n">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>Ruhephasen (S. </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" PageNumberType="TextVariable">
					<TextVariableInstance Self="ud9388" Name="&lt;?AID 001b?&gt;TV XRefPageNumber" ResultText="137" AssociatedTextVariable="dTextVariablen&lt;?AID 001b?&gt;TV XRefPageNumber" />
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>)</Content>
				</CharacterStyleRange>
			</CrossReferenceSource>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> aufgelöst.</Content>
				<Br />
				<Content>Eine Handlungen wie Routinen und Aktionen können in Prozesse umgewandelt werden, wenn absehbar ist, dass sie zum aktuellen Zeitpunkt nicht gelöst werden können. Schwierigkeitsgrade bleiben dabei dann meistens gleich. </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FontStyle="Italic">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Resultate</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Das Resultat einer Probe ist dass, was die Spielleitung der Spielrunde nach einer Probe beschreibt. Wie extrem ein Resultat ausfällt hängt meistens damit zusammen, was die Spielrunde vor hatte und was sie aufs Spiel gesetzt hat.</Content>
				<Br />
				<Content>Dabei ist es oft wichtiger einen Misserfolg definieren zu können als einen Erfolg. Ein Erfolg bedeutet schlicht, dass die Geschichte weitergeht, wie (von den Spielenden) geplant. Misserfolge und Kollaps dagegen werfen den Charakteren Steine in den Weg – und machen damit das Spiel er wirklich interessant. </Content>
				<Br />
				<Content>Erst wenn klar ist, dass es einen „Fehlerzustand“ gibt, braucht man sich überhaupt mit einer Probe befassen. Hat ein Misserfolg keine Konsequenzen, die die Geschichte umlenken können, kann die Spielleitung auch auf eine Probe schlicht verzichten und sich nach der Begabungs- oder Fertigkeitstufe richten, um abzuwägen, wie der Charakter mit der Situation zurecht kommt.</Content>
				<Br />
				<Content>Für ahnungslose Charaktere gibt es gar nicht erst einen Anhaltspunkt, Charaktere mit Grundkenntnisse gelingt ein holpriger Versuch und Experten schaffen in der Regel solche „bedeutgungslosen“ Handlungen.</Content>
				<Br />
				<Content>Bei einer Probe kann es dazu kommen, dass verschiedene Resultate überlappen. Ein Erfolg und kritischer Erfolg können getrennt voneinander auftreten, Kollaps und Erfolg können gleichzeitig bestimmt werden. Es gilt daher, dass alle Ergebnisse, falls möglich auch gleichzeitig zu tragen kommen. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Erfolg</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Damit eine Probe für den Charakter </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Erfolgsformate%3aErfolg">
				<Content>erfolgreich</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> ist, muss der Schwierigkeitsgrad überwunden werden. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Nach Plan: Bei einem Erfolg passiert, was auch immer der Spielende bezwecken wollte. Der Spielende kann relativ frei beschreiben, wie die Probe erfolgreich abgeschlossen wird.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Kritischer Erfolg</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bei einem </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Erfolgsformate%3aKrit">
				<Content>kritischer Erfolg</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> macht der Charakter nicht nur alles richtig, sondern auch noch Glück dabei. Ein kritischer Erfolg übersteigt alle Erwartungen und sollte entsprechend beschrieben werden. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Dritte 9: Eine Probe hat einen kritischen Erfolg, wenn der dritte Würfel im Wurf eine 9 oder 10 zeigt.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Was passiert, wenn die Probe kritisch abgeschlossen wird?</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Die genauen Effekte eines kritischen Erfolges können vom</Content>
				<Content> Spielenden beschrieben werden. Dabei darf ruhig etwas über die Stränge geschlagen werden, dafür ist es ein kritischer Erfolg. Spielmechanisch kann die Spielleitung die folgenden Punkte als Inspiration verwenden.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Zeit ist wichtig: Dauer der Probe verkürzen. </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" />
			<CrossReferenceSource Self="ud938d" AppliedFormat="u9e" Name="Hyperlink 64" Hidden="false" AppliedCharacterStyle="n">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>Aktionseinheiten (S. </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" PageNumberType="TextVariable">
					<TextVariableInstance Self="ud938c" Name="&lt;?AID 001b?&gt;TV XRefPageNumber" ResultText="117" AssociatedTextVariable="dTextVariablen&lt;?AID 001b?&gt;TV XRefPageNumber" />
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>)</Content>
				</CharacterStyleRange>
			</CrossReferenceSource>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> werden halbiert bzw. die </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" />
			<CrossReferenceSource Self="ud9390" AppliedFormat="u9e" Name="Hyperlink 63" Hidden="false" AppliedCharacterStyle="n">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>Zeitstufe (S. </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" PageNumberType="TextVariable">
					<TextVariableInstance Self="ud938f" Name="&lt;?AID 001b?&gt;TV XRefPageNumber" ResultText="42" AssociatedTextVariable="dTextVariablen&lt;?AID 001b?&gt;TV XRefPageNumber" />
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>)</Content>
				</CharacterStyleRange>
			</CrossReferenceSource>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> um 1 gesenkt.</Content>
				<Br />
				<Content>Material wird verbraucht: Es wird ein </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" />
			<CrossReferenceSource Self="ud9392" AppliedFormat="u9e" Name="Hyperlink 65" Hidden="false" AppliedCharacterStyle="n">
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>Materialien (S. </Content>
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" PageNumberType="TextVariable">
					<TextVariableInstance Self="ud9391" Name="&lt;?AID 001b?&gt;TV XRefPageNumber" ResultText="63" AssociatedTextVariable="dTextVariablen&lt;?AID 001b?&gt;TV XRefPageNumber" />
				</CharacterStyleRange>
				<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic">
					<Content>)</Content>
				</CharacterStyleRange>
			</CrossReferenceSource>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> wird für die Probe weniger verwendet.</Content>
				<Br />
				<Content>Resultat der Probe ist wichtig: Was auch immer der Charakter bezwecken wollte, er bekommt mehr davon.</Content>
				<Br />
				<Content>Drama ist wichtig: Ist die Probe per se nicht an eine Spielmechanik gebunden, sondern eher wichtig für die Handlung selbst, darf der Spielende selbst ausschmücken wie großartig sein Charakter die Situation meistert.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Misserfolg</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Die Auswirkungen von Misserfolgen richtet sich vor allem nach der Kategorie der Probe, die ausgeführt wird. Proben im Kampf können bei der nächsten Gelegenheit wiederholt werden, Proben in sozialen Situation können das Verhältnis zum Charakter schädigen. Proben, um etwas zu finden oder wahrzunehmen geben schlicht keine Ergebnisse zurück.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ungenügend: Ist das Ergebnis kleiner als der Schwierigkeitsgrad, spricht man von einem </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Erfolgsformate%3aMisserfolg">
				<Content>Misserfolg</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Was passiert, wenn die Probe nicht geschafft wird?</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bei einem Misserfolg wird der geplante Weg versperrt oder umgeleitet. Wenn eine Tür nicht aufgebrochen werden kann, müssen die Charaktere einen anderen Weg wählen. </Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Misserfolge sollten vor allem zu neuen Wegen einladen, die Geschichte weiterzuführen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Wiederholung: In einigen Fällen kann der Charakter misslungene Proben wiederholen. Wiederholen bedeutet hierbei, dass der Charakter unter den exakt gleichen Umständen diesselbe Probe ablegt. Konfrontationen sind davon ausgenommen, da sich dort die Situation ständig ändert. </Content>
				<Br />
				<Content>Prozess: Der Charakter kann die Probe in einen Prozess umwandeln. Er scheitert vorerst, nimmt sich aber später Zeit, um zu reflektieren und die Aufgabe in Ruhe zu bewältigen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<ParagraphDestination Self="ParagraphDestination/Anker 51" Name="Anker 51" Hidden="false" DestinationUniqueKey="21534" />
				<Content>Kollaps</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Manchmal ist es nicht der Gegner, der den Kampf entscheidet – sondern der Moment, in dem etwas im Inneren bricht.</Content>
				<Br />
				<Content>Ein Kollaps ist kein Zufall und kein reiner Misserfolg. Er ist der Augenblick, in dem die Angst lauter wird als die Vernunft, die Wut stärker als der Wille, oder die Erschöpfung jede Kontrolle erstickt. Es ist der Moment, in dem Instikte die Kontrolle übernehmen.</Content>
				<Br />
				<Content>Ob ein Schrei in die Dunkelheit, ein Faustschlag gegen die Konsole oder das stumme Erstarren mitten im Chaos – der Kollaps zeigt, dass jeder Grenzen hat.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Stress: Erreicht das Würfelergebnis nur das </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aBold">
				<Content>Stress-Level</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> des Charaktes, redet man von einem </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Erfolgsformate%3aPatzer">
				<Content>Kollaps</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Was passiert, wenn der Charakter kollabiert?</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ein Kollaps kann sich Nervenzusammenbruch, Angstattacke oder eine plötzliche Gelähmtheit äußern. Ein Kollaps impliziert, dass der Charakter von seiner eigenen Psyche übermannt wurde und schlicht aufhört zu funktionieren. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Zeitverlust: Der Charakter braucht für die nächste Handlung doppelt so viele AE, verschwendet 1 Prozess oder kann eine Handlung (außerhalb des Aktionseinheiten) erst nach der nächsten Ruhephase versuchen.</Content>
				<Br />
				<Content>Materialverlust: Der Charakter gibt Material aus, wenn er etwas in einem Wutanfall beschädigt hat.</Content>
				<Br />
				<Content>Verzeihen: Es müssen Gefallen ausgegeben werden, wenn der Charakter die Fassung gegenüber einem Verhandlungspartner verloren hat oder einen Freund grundlos angegangen ist.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" ParagraphBreakType="NextColumn">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 2">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Proben gestalten</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Das Gestalten von Proben wird als Spielleitung mit der Zeit ein intuitiver Prozess, kann am Anfang aber noch etwas verwirrend oder mühselig von der Hand gehen, wenn die Spielrunde das System noch nicht oft gespielt hat und noch kein Gefühl für die Abstufungen des Schwierigkeitsgrades da ist. Das ist nur normal! </Content>
				<Br />
				<Content>Der Spielende beschreibt, was der Charakter tun soll und was das gewünschte Ergebnis ist. Die Spielleitung legt darauf hin einen Widerstand fest. Hinweise auf Widerstände finden sich in den Regeln in diesem Buch. Ab einem Punkt kann die Spielleitung Widerstände einfach nach Gefühl festlegen, sollte aber trotzdem die Maßgaben nicht aus den Augen verlieren. </Content>
				<Br />
				<Content>Diese Leitlinien sind für die gesamte Spielrunde entworfen. Auch für die Spielenden ist es wichtig, planen zu können. Sind sie gerade nicht direkt ins Spiel verwickelt, planen viele Spielenden ihre nächsten Schritte. Abschätzen zu können, was für Proben mit was für Widerständen darin vorkommen, sorgt dabei für Planungssicherheit und kann Frustrationen vorbeugen.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FillColor="Color/C=100 M=68 Y=0 K=55">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 3">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Aktionskategorien</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Die fünf Aktionskategorien (Untersuchen, Bewegung, Steuern, Modifizieren, Vermeiden) dienen als standardisierte Stichworte für Gegenstände und Mods, die Charaktere und Ausrüstung besitzen können. Sie schaffen klare Regeln und eindeutige Abgrenzungen, indem sie definieren:</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FontStyle="Bold">
				<Content>Wann genau</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> ein Mod aktiviert wird (z.B. „bei Untersuchen-Proben“ oder „wenn du Bewegung-Aktionen durchführst“)</Content>
				<Br />
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FontStyle="Bold">
				<Content>Welche Boni oder Effekte</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content> in welchen Situationen greifen (z.B. „+2 auf alle Steuerung-Proben mit Technik“)</Content>
				<Br />
				<Content>Anstatt für jeden Gegenstand oder Mod einzeln aufzulisten, welche spezifischen Aktionen er betrifft, verweisen Regeltexte einfach auf eine Aktionskategorie.</Content>
				<Br />
				<Content>Ein kybernetisches Implantat könnte beispielsweise „Bonus auf alle Steuern-Aktionen mit kybernetischen Fertigkeiten“ gewähren, was alle Steuerungs-Handlungen und damit auch automatisch die Kontrolle über das Implantat selbst mit einschließt.</Content>
				<Br />
				<Content>Nahezu alles, was ein Charakter tun kann, lässt sich in fünf Kategorien einteilen. Gegenstände und Mods machen es oft klar, welche Kategorie zur Anwendung kommt. Sollte es nicht ganz so eindeutig sein, hat wie üblich die Spielleitung das letzte Wort.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Standardformate%3aItalic" FontStyle="Bold Italic">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bewegung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bewegung beschreibt jede Aktion, bei der die Position eines Objekts oder eines Charakters verändert wird. Die Intention ist dabei entscheidend: Der Charakter will etwas oder sich selbst an einen anderen Ort bringen. Wie das geschieht – ob durch Laufen, Fliegen, Schwimmen oder das Verschieben von Daten – bestimmt die Umgebung der Probe und damit die relevante Fertigkeit.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Umgebung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Physisch: Sich selbst oder einen Gegenstand bewegen.</Content>
				<Br />
				<Content>Digital: Daten von einem Speicherort zu einem anderen bewegen. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Reichweite</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Das Ziel muss in physischer Reichweite sein, durch ein physisches Mittel verbunden sein oder im Fall digitaler Bewegung im selben Netzwerk existieren.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Fernsteuerung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Drohnen, Fahrzeuge, Maschinen im allgemeinen sowie Systeme lassen sich fernsteuern. Dann führen sie selbst eine Bewegung durch. Der Charakter, der die Bewegung ausgelöst hat, führt dafür eine Steuerung aus.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bearbeitung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Bearbeitung beschreibt jede Aktion, bei der ein Spielwert eines Zielobjekts verändert wird. Dabei ist es gleichgültig ob es sich um einen biologischen Körper, eine Maschine oder ein digitales System handelt – die Mechanik bleibt dieselbe. Bearbeitung verändert immer etwas Messbares. Für jede Bearbeitung ist ein geeignetes Werkzeug notwendig.</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" FillColor="Color/C=100 M=68 Y=0 K=55">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Umgebung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Beispiele für Spielwerte, die durch eine Bearbeitung  verändert werden können</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Physisch: Trefferpunkte von Charakteren, Konstitution, Geschick, Größe</Content>
				<Br />
				<Content>Technisch: Trefferpunkte von Gegenständen, Größe von Gegenständen, Modulklasse, Mods, Konstruktionspunkte</Content>
				<Br />
				<Content>Digital: Modulklasse, Mods, Konstruktionspunkte</Content>
				<Br />
				<Content>Mental: Stress, Mods, Erfahrungspunkte</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Schwierigkeitsgrade</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Spielwerte zur Bestimmung von Schwierigkeiten bei Bearbeitungen können z.B sein</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Modulklasse: 10 + 2 x MK für Bearbeitungen an Gegenständen.</Content>
				<Br />
				<Content>Begabung: 10 + 2 x Konstitution für Bearbeitungen an Charakteren.</Content>
				<Br />
				<Content>Stress: 10 + Stress für Bearbeitungen am Stresswert</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Werkzeug</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Jede Bearbeitung erfordert ein zur Situation passendes Werkzeug. Ohne Werkzeug ist keine Bearbeitung möglich.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Analyse</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Analyse beschreibt jede Aktion, bei der ein Charakter Informationen über ein Objekt gewinnt. Eine Analyse verändert nichts – sie liest aus. Der Erfolgsgrad bestimmt die Tiefe und Genauigkeit der gewonnenen Information. Ein normaler Erfolg gibt alle für die Geschichte relevanten Informationen preis oder genau die Informationen nach denen gefragt wurde.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Umgebung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Physisch: Die unmittelbare Umgebung nach Gegenständen, Personen oder Spuren absuc</Content>
				<Content>hen.</Content>
				<Br />
				<Content>Technisch: Mittels Sensoren oder anderen technischen Hilfsmitteln das elektromagnetische Spektrum, Geräusche und Material in jedem Aggregatszustand untersuchen.</Content>
				<Br />
				<Content>Digital: Nach Datensätzen, Passwörtern, digitalen Spuren, Dokumenten, Bildern oder Videos suchen.</Content>
				<Br />
				<Content>Mental: Einen Gegenüber auf sein Verhalten hin untersuchen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Analyse-Proben</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Ein Ziel das sich aktiv versteckt oder versteckt wurde, muss eine Vermeidung durchführen. Das Ergebnis der Probe wird zum Schwierigkeitgrad für die </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/Inline-Probe">
				<Content>suchende </Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Analyse.</Content>
				<Br />
				<Content>Erfolg: Der Charakter lokalisiert das Ziel. Die SL gibt den Aufenthaltsort preis.</Content>
				<Br />
				<Content>Misserfolg: Das Ziel bleibt unentdeckt. Der Charakter weiß nicht ob das Ziel nicht vorhanden ist oder ob die Suche schlicht gescheitert ist.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Steuerung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Steuerung beschreibt jede Aktion, bei der ein Charakter die Intention eines Objekts beeinflusst und damit Kontrolle über sein Verhalten erlangt. Steuerung greift eine Ebene höher als Modifikation: nicht Eigenschaften, sondern Absichten und Verhalten werden verändert. Eine erfolgreiche Steuerung hält so lange an bis das Signal abreißt oder eine andere Steuerung übernimmt.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Umgebung</Content>
			</CharacterStyleRange>
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]" PointSize="9">
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Technisch: Eine Drohne fernsteuern oder eine Maschine bedienen.</Content>
				<Br />
				<Content>Digital: KI-Agenten kontrollieren, Befehle an ein System schicken wie ein Programm starten oder Daten löschen.</Content>
				<Br />
				<Content>Mental: Jemanden anlügen. Jemanden die eigene, subjektive Wahrheit aufzwängen. Jemandes Entscheidungen beeinflussen.</Content>
				<Br />
				<Content>Sozial: Die Laune einer Gruppe von Personen verändern, abflachen oder anstacheln. </Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Direkt vs. Indirekt</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Eine Steuerung kann direkt sein – der Charakter beschreibt die konkrete Handlung des Ziels und dieses führt sie bei Erfolg aus.</Content>
				<Br />
				<Content>Sie kann aber auch indirekt sein – der Charakter gibt eine Intention vor, und die SL bestimmt wie das Ziel diese umsetzt. In beiden Fällen hält die Steuerung so lange an, wie der Charakter aktiv Einfluss nehmen kann.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Steuerungsproben</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Der Charakter würfelt gegen den Schwierigkeitsgrad des Ziels. Ziele mit eigener Intention – Personen, KIs, autonome Systeme – würfeln einen Gegenwurf.</Content>
				<Br />
				<Content>Erfolg: Das Ziel führt die beschriebene Handlung aus. Der Spielende bestimmt das Verhalten des Ziels.</Content>
				<Br />
				<Content>Misserfolg: Das Ziel folgt der Anweisung nicht. Bei Zielen mit eigener Intention ist der Steuerungsversuch dem Ziel möglicherweise bewusst.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Überschriften%3aHeading 4">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Vermeidung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/$ID/NormalParagraphStyle">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Vermeidung ist die einzige bedrohungsorientierte Kategorie. Alle anderen Kategorien richten sich auf ein Ziel das erreicht werden soll – Vermeidung richtet sich gegen eine Bedrohung die abgewendet werden soll. Die Methode ist dabei irrelevant: ob der Charakter ausweicht, eine Parade ausführt, eine Firewall aktiviert oder Stellung bezieht – entscheidend ist allein die Intention, eine Konsequenz zu verhindern.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Umgebung</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeldAufzählung">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Physisch: Einen Angriff abwehren. Sich aus dem Gebiet einer drohenden Gefahr entfernen.</Content>
				<Br />
				<Content>Technisch: Türen und Fenster verschließen. </Content>
				<Br />
				<Content>Digital: Firewalls und Sicherheits-KIs hochfahren. Hackerangriffe abwehren.</Content>
				<Br />
				<Content>Mental: Lügenkonstrukte durchbrechen. Beeinflussung und Einschüchterung abschütteln.</Content>
				<Br />
				<Content>Sozial: as eigene Gesicht wahren. Mut im Angesicht von drohender Gefahr zeigen.</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelFeldHead">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
				<Content>Proaktiv vs. Reaktiv</Content>
				<Br />
			</CharacterStyleRange>
		</ParagraphStyleRange>
		<ParagraphStyleRange AppliedParagraphStyle="ParagraphStyle/Regeltexte%3aRegelfeld">
			<CharacterStyleRange AppliedCharacterStyle="CharacterStyle/$ID/[No character style]">
